/**
 * Prisma schema — six models from 04-data-model.md.
 * Why: Campaign, ConstraintSet, ConstraintSnapshot, JudgementRule, Asset, Finding.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id                      String   @id @default(uuid())
  freeText                String   @default("")
  structuredBrief         Json?
  currentConstraintSetId  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  currentConstraintSet ConstraintSet?  @relation("CampaignCurrentSet", fields: [currentConstraintSetId], references: [id], onDelete: Restrict)
  constraintSets       ConstraintSet[] @relation("CampaignConstraintSets")
  assets               Asset[]

  @@index([updatedAt])
}

model ConstraintSet {
  id           String   @id @default(uuid())
  campaignId   String
  rulesetHash  String
  createdAt    DateTime @default(now())

  campaign             Campaign             @relation("CampaignConstraintSets", fields: [campaignId], references: [id], onDelete: Restrict)
  snapshots            ConstraintSnapshot[]
  assets               Asset[]
  currentForCampaigns  Campaign[]           @relation("CampaignCurrentSet")
}

model ConstraintSnapshot {
  constraintSetId      String
  ruleId               String
  kind                 String
  wording              String
  predicateFingerprint String
  matcherFingerprint   String?

  constraintSet ConstraintSet @relation(fields: [constraintSetId], references: [id], onDelete: Cascade)

  @@id([constraintSetId, ruleId])
}

model JudgementRule {
  id            String   @id @default(uuid())
  wording       String
  predicateSpec Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Asset {
  id                 String   @id @default(uuid())
  campaignId         String
  channel            String
  constraintSetId    String
  headline           String
  body               String
  disclaimer         String
  cta                String
  canonicalText      String
  fieldOffsets       Json
  runHash            String
  rulesetHash        String
  kitFingerprint     String
  generatedAt        DateTime @default(now())
  regeneratedFromId  String?
  generationIndex    Int
  generatorRunId     String?

  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  constraintSet   ConstraintSet @relation(fields: [constraintSetId], references: [id], onDelete: Restrict)
  regeneratedFrom Asset?        @relation("AssetLineage", fields: [regeneratedFromId], references: [id], onDelete: Restrict)
  regenerations   Asset[]       @relation("AssetLineage")
  generatorRun    AgentRun?     @relation("AssetGeneratorRun", fields: [generatorRunId], references: [id], onDelete: Restrict)
  findings        Finding[]

  @@index([generatedAt])
}

model Finding {
  id                String    @id @default(uuid())
  assetId           String
  ruleId            String
  kind              String
  evaluationStatus  String
  machineVerdict    String?
  machineReason     String?
  spans             Json
  machineAt         DateTime?
  humanVerdict      String?
  humanReason       String?
  humanActor        String?
  humanAt           DateTime?
  judgeRunId        String?

  asset     Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  judgeRun  AgentRun?          @relation("FindingJudgeRun", fields: [judgeRunId], references: [id], onDelete: Restrict)
  decisions FindingDecision[]

  @@unique([assetId, ruleId])
}

model FindingDecision {
  id              String   @id @default(uuid())
  findingId       String
  action          String
  previousVerdict String?
  verdict         String?
  reason          String?
  actor           String
  at              DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, at])
}

model AgentRun {
  id               String   @id @default(uuid())
  agentName        String
  agentDefVersion  String
  model            String
  linkageKind      String
  linkageId        String?
  promptHash       String
  outputHash       String
  promptPreview    String
  outputPreview    String
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  costUsd          Float?
  latencyMs        Int
  skillsRead       Json
  injectionSignals Json
  chatFlags        Json
  ok               Boolean
  errorKind        String?
  occurredAt       DateTime @default(now())

  assets   Asset[]   @relation("AssetGeneratorRun")
  findings Finding[] @relation("FindingJudgeRun")

  @@index([agentName, occurredAt])
  @@index([linkageKind, linkageId])
}
